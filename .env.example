# =================================================================
# STRUCTURA AI - Environment Configuration Example
# =================================================================

PROJECT_NAME="STRUCTURA AI"
VERSION="1.0.0"
DESCRIPTION="Autonomous Infrastructure Health Monitoring and Structural Integrity Prediction System"

# Security & Authentication
SECRET_KEY="structura-super-secret-jwt-key-replace-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback:
DATABASE_URL="sqlite:///./structura.db"
# Production PostgreSQL + PostGIS:
# DATABASE_URL="postgresql://structura_user:structura_pass@localhost:5432/structura_db"

# API & CORS
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Computer Vision & Machine Learning Settings
DEMO_MODE=true
YOLO_MODEL_PATH="models/yolov8_defects.pt"
